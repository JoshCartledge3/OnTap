{
  "expo": {
    "name": "ontap-client",
    "slug": "ontap-client",
    "scheme": "ontap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.c.jxsh.ontap-client"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.c.jxsh.ontapclient"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow OnTap to use your location to find nearby pubs."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-router",
      "expo-status-bar",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./src/assets/fonts/dm-sans/static/DMSans-Light.ttf",
              "./src/assets/fonts/dm-sans/static/DMSans-LightItalic.ttf",
              "./src/assets/fonts/dm-sans/static/DMSans-Regular.ttf",
              "./src/assets/fonts/dm-sans/static/DMSans-Italic.ttf",
              "./src/assets/fonts/dm-sans/static/DMSans-Bold.ttf",
              "./src/assets/fonts/dm-sans/static/DMSans-BoldItalic.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "DM Sans 9pt",
                "fontDefinitions": [
                  {
                    "path": "./src/assets/fonts/dm-sans/static/DMSans-Light.ttf",
                    "weight": 300,
                    "style": "normal"
                  },
                  {
                    "path": "./src/assets/fonts/dm-sans/static/DMSans-LightItalic.ttf",
                    "weight": 300,
                    "style": "italic"
                  },
                  {
                    "path": "./src/assets/fonts/dm-sans/static/DMSans-Regular.ttf",
                    "weight": 400,
                    "style": "normal"
                  },
                  {
                    "path": "./src/assets/fonts/dm-sans/static/DMSans-Italic.ttf",
                    "weight": 400,
                    "style": "italic"
                  },
                  {
                    "path": "./src/assets/fonts/dm-sans/static/DMSans-Bold.ttf",
                    "weight": 700,
                    "style": "normal"
                  },
                  {
                    "path": "./src/assets/fonts/dm-sans/static/DMSans-BoldItalic.ttf",
                    "weight": 700,
                    "style": "italic"
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/splash/splash.png",
          "backgroundColor": "#F6F3E9",
          "imageWidth": 300,
          "resizeMode": "contain"
        }
      ],
      [
        "react-native-auth0",
        {
          "domain": "dev-6p61uii3flewdqu3.us.auth0.com",
          "customScheme": "ontap"
        }
      ]
    ]
  }
}
